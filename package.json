{
  "name": "@shibubu/sdk",
  "version": "0.3.0",
  "description": "Typed client for the Shibubu API \u2014 a virtual buddy that grows from how you interact with AI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/client.test.ts",
    "check": "tsc --noEmit && npm test"
  },
  "keywords": [
    "shibubu",
    "mcp",
    "ai",
    "agent",
    "sdk"
  ],
  "homepage": "https://shibubu.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/shibu003/shibubu-sdk.git"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0"
  }
}
